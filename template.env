# Copy to .env, adjust values, then load with: source .env
# Command-line options override these values.

export SWISSQUOTE_TAX_FX_MODE=daily
export SWISSQUOTE_TAX_ROUND=false
export SWISSQUOTE_TAX_NO_DETAILS=false
# Optional overrides.
# export SWISSQUOTE_TAX_TAX_YEAR=2025
# export SWISSQUOTE_TAX_ROUND=true
# export SWISSQUOTE_TAX_NO_DETAILS=true
# export SWISSQUOTE_TAX_OUTPUT=steuer_2025.csv

# Use space-separated values for options that accept several transaction types.
# export SWISSQUOTE_TAX_DIVIDEND_TYPES="Dividende"
# export SWISSQUOTE_TAX_INTEREST_TYPES="Zinsen auf Einlagen"
# export SWISSQUOTE_TAX_WITHHOLDING_TAX_TYPES="Steuerrückbehalt Quellensteuer Withholding Tax"
# export SWISSQUOTE_TAX_PURCHASE_TYPES="Kauf"
# export SWISSQUOTE_TAX_SALE_TYPES="Verkauf"

# Adapt these only when your CSV headers differ from the Swissquote defaults.
# export SWISSQUOTE_TAX_COL_WITHHOLDING_TAX=Quellensteuer

# export SWISSQUOTE_TAX_WITHHOLDING_TAX_RULES=withholding-tax-rules.toml
